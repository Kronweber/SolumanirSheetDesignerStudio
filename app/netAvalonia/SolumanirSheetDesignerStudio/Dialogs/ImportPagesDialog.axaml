<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SolumanirSheetDesignerStudio.App.ViewModels"
        xmlns:l="using:SolumanirSheetDesignerStudio.App.Services"
        x:Class="SolumanirSheetDesignerStudio.App.Dialogs.ImportPagesDialog"
        x:DataType="vm:ImportPagesViewModel"
        Title="{l:T 'Import pages'}"
        Width="560" Height="620" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,12"
               Text="{l:T 'The chosen pages are copied into this project together with the images they use.'}" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Left" Content="{l:T 'Select all / none'}" Command="{Binding CheckAllCommand}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="primary" Content="{l:T Import}" MinWidth="96" HorizontalContentAlignment="Center" IsDefault="True" Click="OnOk" />
        <Button Content="{l:T Cancel}" MinWidth="96" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
      </StackPanel>
    </DockPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ImportPageRow">
            <Border Classes="card" Margin="0,0,0,6">
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="2,0,10,0" />
                <Border DockPanel.Dock="Left" Width="64" Height="64" Background="#1A1715" ClipToBounds="True" Margin="0,0,12,0">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontFamily="{StaticResource BodyFont}" FontSize="17" />
                  <TextBlock Classes="hint" Text="{Binding Details}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
